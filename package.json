{
  "name": "vrtx-react-native",
  "version": "0.1.105",
  "description": "vrtx react-native",
  "keywords": [
    "android",
    "cards",
    "expo",
    "fintech",
    "ios",
    "mobile",
    "onboarding",
    "react-native",
    "sdk",
    "vrtx",
    "vrtx-react-native",
    "wallet"
  ],
  "homepage": "https://github.com/vrtx-fintech/vrtx-react-native#readme",
  "bugs": {
    "url": "https://github.com/vrtx-fintech/vrtx-react-native/issues"
  },
  "license": "Apache-2.0",
  "author": "vrtx developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrtx-fintech/vrtx-react-native.git"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "release": "echo \"Releases are published by CI: Actions -> Release. See README > Releasing.\" && exit 1",
    "open:ios": "xed example/ios",
    "open:android": "npm run android --",
    "android": "npm --prefix example run android --",
    "ios": "npm --prefix example run ios --",
    "test:workflows": "node --test scripts/__tests__/*.test.cjs"
  },
  "devDependencies": {
    "@react-native/assets-registry": "^0.88.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "expo": "^58.0.26",
    "expo-module-scripts": "56.0.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.68.0",
    "react": "19.3.1",
    "react-native": "0.88.1"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    },
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "eslint-plugin-react-hooks": {
      "zod": "4.6.6"
    },
    "expo-module-scripts": {
      "glob": "14.0.6"
    },
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "node-forge": "1.4.4",
    "test-exclude@7": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    },
    "ws@7": "7.5.11",
    "ws@8": "8.21.0"
  },
  "jest": {
    "preset": "expo-module-scripts"
  }
}
