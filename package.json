{
  "name": "vrtx-react-native",
  "version": "0.1.76",
  "description": "vrtx react-native",
  "keywords": [
    "android",
    "cards",
    "expo",
    "fintech",
    "ios",
    "mobile",
    "onboarding",
    "react-native",
    "sdk",
    "vrtx",
    "vrtx-react-native",
    "wallet"
  ],
  "homepage": "https://github.com/vrtx-fintech/vrtx-react-native#readme",
  "bugs": {
    "url": "https://github.com/vrtx-fintech/vrtx-react-native/issues"
  },
  "license": "Apache-2.0",
  "author": "vrtx developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrtx-fintech/vrtx-react-native.git"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "release": "npm version patch --no-git-tag-version && npm publish",
    "open:ios": "xed example/ios",
    "open:android": "cd example/android && ./gradlew :app:installDebug --no-build-cache"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "expo": "^56.0.8",
    "expo-module-scripts": "^56.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.68.0",
    "react-native": "0.86.0"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "jest": {
    "passWithNoTests": true
  }
}
