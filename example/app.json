{
  "expo": {
    "name": "vrtx-react-native-example",
    "slug": "vrtx-react-native-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.vrtx.reactnative.example"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sa.vrtx.reactnative.example",
      "minSdkVersion": 29
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "kotlinVersion": "2.1.20"
          },
          "ios": {
            "deploymentTarget": "16.6"
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/font/geom_light.ttf",
              "./assets/font/geom_regular.ttf",
              "./assets/font/geom_medium.ttf",
              "./assets/font/geom_semibold.ttf",
              "./assets/font/geom_bold.ttf",
              "./assets/font/inter_regular.ttf",
              "./assets/font/inter_medium.ttf",
              "./assets/font/inter_semibold.ttf",
              "./assets/font/inter_bold.ttf",
