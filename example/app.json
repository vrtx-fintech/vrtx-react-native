              "./assets/font/jura_medium.ttf",
              "./assets/font/jura_semibold.ttf",
              "./assets/font/jura_bold.ttf",
              "./assets/font/jockey_one_regular.ttf",
              "./assets/font/ibm_plex_sans_arabic_light.ttf",
              "./assets/font/ibm_plex_sans_arabic_regular.ttf",
              "./assets/font/ibm_plex_sans_arabic_medium.ttf",
              "./assets/font/ibm_plex_sans_arabic_semibold.ttf",
              "./assets/font/ibm_plex_sans_arabic_bold.ttf",
